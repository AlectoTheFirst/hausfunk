# Copy to .env and fill in. Every HAUSFUNK_* variable can also be given as HAUSFUNK_*_FILE
# pointing at a file that contains the value (Podman/Kubernetes secrets).
# Nested keys use "__": HAUSFUNK_<SECTION>__<KEY>. Env wins over config/hausfunk.yaml.

# Path to the structural config (channels, profiles, personas, feeds)
HAUSFUNK_CONFIG=config/hausfunk.yaml

# Jellyfin (required)
HAUSFUNK_JELLYFIN__URL=http://jellyfin.lan:8096
HAUSFUNK_JELLYFIN__API_KEY=
# HAUSFUNK_JELLYFIN__USER_ID=

# Claude API (required)
HAUSFUNK_ANTHROPIC__API_KEY=
# HAUSFUNK_ANTHROPIC__BASE_URL=
# HAUSFUNK_DIRECTOR__MODEL=claude-sonnet-5-5
# HAUSFUNK_DIRECTOR__BULK_MODEL=claude-haiku-5-5

# Icecast (required). The same passwords are passed to the Icecast and Liquidsoap containers.
HAUSFUNK_ICECAST__URL=http://localhost:8000
HAUSFUNK_ICECAST__SOURCE_PASSWORD=change-me-source
HAUSFUNK_ICECAST__ADMIN_PASSWORD=change-me-admin

# Liquidsoap control interface
HAUSFUNK_LIQUIDSOAP__HOST=localhost
HAUSFUNK_LIQUIDSOAP__PORT=1234

# TTS: piper | elevenlabs
HAUSFUNK_TTS__PROVIDER=piper
# HAUSFUNK_TTS__URL=http://localhost:5000
# HAUSFUNK_ELEVENLABS__API_KEY=

# Home Assistant (optional; set both or neither)
# HAUSFUNK_HOMEASSISTANT__URL=http://homeassistant.lan:8123
# HAUSFUNK_HOMEASSISTANT__TOKEN=

# Liquidsoap channels (comma-separated slugs; must match the channels in the config)
LIQUIDSOAP_CHANNELS=hausfunk,nachtschicht-fm
